<?xml version="1.0"?> 
<robot name="simplespot">
    <!-- Colors --> 
    <material name="green">
        <color rgba="0 0.925 0 1"/>
    </material>

    <!-- Goal -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.5 0.3 0.01"/>
            </geometry>
            <material name="green"/>
        </visual>
        <collision> 
             <geometry> 
                <box size="0.5 0.3 0.1"/>

            </geometry>
        </collision> 
        <inertial> 
            <mass value="0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial> 
    </link>
</robot>

